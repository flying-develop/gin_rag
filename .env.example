# Приложение
APP_NAME=ai-app-go
LOG_LEVEL=INFO
# Порт, на котором слушает сервис (внутри контейнера всегда 8080).
HTTP_PORT=8080
# Порт на хосте, на который проброшен app в docker-compose.
APP_HOST_PORT=8080

# PostgreSQL. Хост "postgres" совпадает с именем сервиса в docker-compose.
DATABASE_URL=postgres://aiapp:aiapp@postgres:5432/ai_app?sslmode=disable
# Используются самим контейнером postgres — держать синхронно с DATABASE_URL.
POSTGRES_USER=aiapp
POSTGRES_PASSWORD=aiapp
POSTGRES_DB=ai_app

# Redis. Хост "redis" совпадает с именем сервиса в docker-compose.
REDIS_URL=redis://redis:6379/0

# Qdrant. Хост "qdrant" совпадает с именем сервиса в docker-compose.
QDRANT_URL=http://qdrant:6333

# LLM-провайдер
OPENAI_API_KEY=
